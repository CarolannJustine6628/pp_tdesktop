@@ -0,0 +1,258 @@
+#include "storage/local_message_index.h"
+#include "core/core_settings.h"
+#include "base/platform/base_platform_info.h"
+
+#include <QtCore/QRegularExpression>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QDataStream>
+#include <QtCore/QStandardPaths>
+#include <QtCore/QBuffer>
+#include <algorithm>
+
+#include <openssl/evp.h>
+#include <openssl/rand.h>
+
+namespace Storage {
+
+namespace {
+    LocalMessageIndex *_instance = nullptr;
+}
+
+LocalMessageIndex *LocalMessageIndex::Instance() {
+    if (!_instance) {
+        _instance = new LocalMessageIndex();
+    }
+    return _instance;
+}
+
+LocalMessageIndex::LocalMessageIndex() {
+}
+
+QString LocalMessageIndex::getFilePath(quint64 peerId) {
+    QString path = cWorkingDir() + "tdata/local_message_index/";
+    QDir().mkpath(path);
+    return path + QString::number(peerId) + ".dat";
+}
+
+void LocalMessageIndex::ensureKey() {
+    if (!_key.isEmpty()) return;
+
+    QString dirPath = cWorkingDir() + "tdata/local_message_index/";
+    QDir().mkpath(dirPath);
+    QString keyPath = dirPath + "key";
+    
+    QFile file(keyPath);
+    if (file.exists() && file.open(QIODevice::ReadOnly)) {
+        _key = file.readAll();
+        if (_key.size() == 32) return;
+    }
+    
+    _key.resize(32);
+    if (RAND_bytes(reinterpret_cast<unsigned char*>(_key.data()), 32) != 1) {
+        _key.clear();
+        return;
+    }
+    
+    if (file.open(QIODevice::WriteOnly)) {
+        file.write(_key);
+    }
+}
+
+void LocalMessageIndex::loadFile(quint64 peerId) {
+    if (_cache.contains(peerId)) return;
+    ensureKey();
+
+    QFile file(getFilePath(peerId));
+    if (!file.open(QIODevice::ReadOnly)) {
+        _cache.insert(peerId, {});
+        return;
+    }
+
+    QByteArray fileData = file.readAll();
+    QByteArray decryptedData;
+    bool success = false;
+
+    if (_key.size() == 32 && fileData.size() >= 12 + 16) { // Nonce(12) + Tag(16)
+        QByteArray nonce = fileData.left(12);
+        QByteArray ciphertext = fileData.mid(12, fileData.size() - 12 - 16);
+        QByteArray tag = fileData.right(16);
+
+        EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+        if (ctx) {
+            if (EVP_DecryptInit_ex(ctx, EVP_aes_256_gcm(), NULL, NULL, NULL) == 1 &&
+                EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, 12, NULL) == 1 &&
+                EVP_DecryptInit_ex(ctx, NULL, NULL, (const unsigned char*)_key.constData(), (const unsigned char*)nonce.constData()) == 1) {
+                
+                decryptedData.resize(ciphertext.size());
+                int len = 0;
+                if (EVP_DecryptUpdate(ctx, (unsigned char*)decryptedData.data(), &len, (const unsigned char*)ciphertext.constData(), ciphertext.size()) == 1) {
+                    int plaintextLen = len;
+                    EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_TAG, 16, (void*)tag.constData());
+                    if (EVP_DecryptFinal_ex(ctx, (unsigned char*)decryptedData.data() + len, &len) == 1) {
+                         plaintextLen += len;
+                         decryptedData.resize(plaintextLen);
+                         success = true;
+                    }
+                }
+            }
+            EVP_CIPHER_CTX_free(ctx);
+        }
+    }
+
+    if (!success && !fileData.isEmpty()) {
+        // Decryption failed
+    }
+    
+    auto &map = _cache[peerId];
+    if (success) {
+        QDataStream in(decryptedData);
+        in.setVersion(QDataStream::Qt_5_1);
+        while (!in.atEnd()) {
+            qint64 mId;
+            qint32 mDate;
+            quint64 mFrom;
+            QString mText;
+            in >> mId >> mDate >> mFrom >> mText;
+            
+            if (in.status() != QDataStream::Ok) break;
+
+            LocalMessage msg;
+            msg.peerId = peerId;
+            msg.msgId = mId;
+            msg.date = mDate;
+            msg.fromId = mFrom;
+            msg.text = mText;
+            
+            map.insert(mId, msg);
+        }
+    }
+}
+
+void LocalMessageIndex::flushFile(quint64 peerId) {
+    if (!_cache.contains(peerId)) return;
+    ensureKey();
+    if (_key.size() != 32) return;
+
+    QByteArray data;
+    {
+        QDataStream out(&data, QIODevice::WriteOnly);
+        out.setVersion(QDataStream::Qt_5_1);
+
+        const auto &map = _cache[peerId];
+        for (auto it = map.constBegin(); it != map.constEnd(); ++it) {
+            const auto &msg = it.value();
+            out << qint64(msg.msgId) << qint32(msg.date) << quint64(msg.fromId) << msg.text;
+        }
+    }
+
+    // Encrypt
+    QByteArray nonce(12, 0);
+    if (RAND_bytes((unsigned char*)nonce.data(), 12) != 1) return;
+
+    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+    if (!ctx) return;
+    
+    bool ok = false;
+    QByteArray ciphertext;
+    QByteArray tag(16, 0);
+    
+    if (EVP_EncryptInit_ex(ctx, EVP_aes_256_gcm(), NULL, NULL, NULL) == 1 &&
+        EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, 12, NULL) == 1 &&
+        EVP_EncryptInit_ex(ctx, NULL, NULL, (const unsigned char*)_key.constData(), (const unsigned char*)nonce.constData()) == 1) {
+        
+        ciphertext.resize(data.size() + 16);
+        int len = 0;
+        if (EVP_EncryptUpdate(ctx, (unsigned char*)ciphertext.data(), &len, (const unsigned char*)data.constData(), data.size()) == 1) {
+            int ciphertextLen = len;
+            if (EVP_EncryptFinal_ex(ctx, (unsigned char*)ciphertext.data() + len, &len) == 1) {
+                ciphertextLen += len;
+                ciphertext.resize(ciphertextLen);
+                
+                if (EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_GET_TAG, 16, (void*)tag.data()) == 1) {
+                    ok = true;
+                }
+            }
+        }
+    }
+    EVP_CIPHER_CTX_free(ctx);
+
+    if (ok) {
+        QFile file(getFilePath(peerId));
+        if (file.open(QIODevice::WriteOnly)) {
+            file.write(nonce);
+            file.write(ciphertext);
+            file.write(tag);
+        }
+    }
+}
+
+void LocalMessageIndex::save(quint64 peerId, int64 msgId, int date, quint64 fromId, const QString &text) {
+    if (text.isEmpty()) return;
+    if (msgId <= 0 || msgId >= 0x7FFFFFFF) return;
+    
+    loadFile(peerId);
+    auto &map = _cache[peerId];
+
+    if (map.contains(msgId)) {
+        const auto &existing = map[msgId];
+        if (existing.text == text && existing.date == date && existing.fromId == fromId) {
+            return;
+        }
+    }
+
+    LocalMessage msg;
+    msg.peerId = peerId;
+    msg.msgId = msgId;
+    msg.date = date;
+    msg.fromId = fromId;
+    msg.text = text;
+
+    map.insert(msgId, msg);
+    flushFile(peerId);
+}
+
+void LocalMessageIndex::remove(quint64 peerId, int64 msgId) {
+    loadFile(peerId);
+    auto &map = _cache[peerId];
+    if (map.remove(msgId)) {
+        flushFile(peerId);
+    }
+}
+
+std::vector<LocalMessage> LocalMessageIndex::search(quint64 peerId, const QString &query, int64 offsetId, int minDate, int maxDate, quint64 fromId, int limit) {
+    std::vector<LocalMessage> result;
+    
+    loadFile(peerId);
+    const auto &map = _cache[peerId];
+
+    auto it = map.constEnd();
+    while (it != map.constBegin()) {
+        --it;
+        const auto &msg = it.value();
+
+        if (offsetId > 0 && msg.msgId >= offsetId) continue;
+        if (minDate > 0 && msg.date < minDate) continue;
+        if (maxDate > 0 && msg.date > maxDate) continue;
+        if (fromId > 0 && msg.fromId != fromId) continue;
+        
+        if (!query.isEmpty()) {
+            const auto words = query.split(QRegularExpression("\\s+"), Qt::SkipEmptyParts);
+            bool allFound = true;
+            for (const auto &word : words) {
+                if (!msg.text.contains(word, Qt::CaseInsensitive)) {
+                    allFound = false;
+                    break;
+                }
+            }
+            if (!allFound) continue;
+        }
+
+        result.push_back(msg);
+        if (limit > 0 && result.size() >= limit) break;
+    }
+
+    return result;
+}
+
+} // namespace Storage
