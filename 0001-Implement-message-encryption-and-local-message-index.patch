@@ -0,0 +1,48 @@
+/*
+This file is part of Telegram Desktop,
+the official desktop application for the Telegram messaging service.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#pragma once
+
+#include <QString>
+#include <QByteArray>
+
+namespace Core {
+
+class MessageEncryption {
+public:
+	static MessageEncryption &Instance();
+	
+	// Initialize encryption key from sec.txt file
+	bool initialize();
+	
+	// Encrypt text message (AES-256 + Base64)
+	QString encryptMessage(const QString &text);
+	
+	// Decrypt text message (Base64 decode + AES-256 decrypt)
+	QString decryptMessage(const QString &encryptedText);
+	
+	// Check if encryption is enabled
+	bool isEnabled() const { return _enabled; }
+
+private:
+	MessageEncryption() = default;
+	~MessageEncryption() = default;
+	MessageEncryption(const MessageEncryption &) = delete;
+	MessageEncryption &operator=(const MessageEncryption &) = delete;
+	
+	bool _enabled = false;
+	QByteArray _aesKey;
+	QByteArray _aesIv;
+	
+	bool loadKeyFromFile();
+	void generateKeyFromContent(const QByteArray &content);
+	QByteArray padData(const QByteArray &data);
+	QByteArray unpadData(const QByteArray &data);
+};
+
+} // namespace Core
+
