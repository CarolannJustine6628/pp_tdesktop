+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"html/template"
+	"log"
+	"net/http"
+	"time"
+)
+
+var indexer *Indexer
+
+const htmlTemplate = `
+<!DOCTYPE html>
+<html>
+<head>
+    <title>Telegram Local Search</title>
+    <style>
+        body { font-family: sans-serif; margin: 0; padding: 0; height: 100vh; display: flex; flex-direction: column; }
+        header { padding: 20px; background: #f5f5f5; border-bottom: 1px solid #ddd; }
+        .search-box { display: flex; gap: 10px; max-width: 800px; margin: 0 auto; }
+        input { flex-grow: 1; padding: 10px; font-size: 16px; }
+        button { padding: 10px 20px; font-size: 16px; cursor: pointer; }
+        
+        #container { flex: 1; display: flex; overflow: hidden; }
+        
+        #sidebar { 
+            width: 300px; 
+            border-right: 1px solid #ddd; 
+            overflow-y: auto; 
+            background: #fafafa;
+        }
+        .peer-item {
+            padding: 15px;
+            border-bottom: 1px solid #eee;
+            cursor: pointer;
+            transition: background 0.2s;
+        }
+        .peer-item:hover { background: #eee; }
+        .peer-item.active { background: #e0e0e0; font-weight: bold; }
+        .peer-id { font-size: 0.9em; color: #333; }
+        .peer-count { font-size: 0.8em; color: #888; float: right; }
+
+        #main { flex: 1; overflow-y: auto; padding: 20px; background: #fff; }
+        
+        .result { border: 1px solid #ddd; padding: 15px; margin-bottom: 10px; border-radius: 5px; }
+        .meta { color: #666; font-size: 0.9em; margin-bottom: 5px; border-bottom: 1px solid #eee; padding-bottom: 5px; }
+        .text { white-space: pre-wrap; font-size: 1.1em; line-height: 1.5; }
+        
+        .empty-state { text-align: center; color: #888; margin-top: 50px; }
+    </style>
+</head>
+<body>
+    <header>
+        <div class="search-box">
+            <input type="text" id="query" placeholder="Enter keywords..." onkeypress="handleEnter(event)">
+            <button onclick="doSearch()">Search</button>
+        </div>
+    </header>
+    <div id="container">
+        <div id="sidebar"></div>
+        <div id="main">
+            <div class="empty-state">Search something to see results</div>
+        </div>
+    </div>
+
+    <script>
+        let currentData = {};
+
+        function handleEnter(e) {
+            if (e.key === 'Enter') doSearch();
+        }
+
+        async function doSearch() {
+            const query = document.getElementById('query').value;
+            if (!query.trim()) return;
+
+            document.getElementById('sidebar').innerHTML = '<div style="padding:20px">Searching...</div>';
+            document.getElementById('main').innerHTML = '';
+
+            const res = await fetch('/api/search?q=' + encodeURIComponent(query));
+            currentData = await res.json();
+            
+            renderSidebar();
+        }
+
+        function renderSidebar() {
+            const sidebar = document.getElementById('sidebar');
+            sidebar.innerHTML = '';
+            
+            const peerIds = Object.keys(currentData).sort((a, b) => currentData[b].length - currentData[a].length); // Sort by count desc
+            
+            if (peerIds.length === 0) {
+                sidebar.innerHTML = '<div style="padding:20px">No results found.</div>';
+                return;
+            }
+
+            peerIds.forEach(peerId => {
+                const msgs = currentData[peerId];
+                const div = document.createElement('div');
+                div.className = 'peer-item';
+                div.onclick = () => selectPeer(peerId, div);
+                div.innerHTML = '<span class="peer-id">Chat ' + peerId + '</span>' + 
+                              '<span class="peer-count">' + msgs.length + '</span>';
+                sidebar.appendChild(div);
+            });
+
+            // Auto-select first
+            if (peerIds.length > 0) {
+                sidebar.firstChild.click();
+            }
+        }
+
+        function selectPeer(peerId, el) {
+            // Update active state
+            document.querySelectorAll('.peer-item').forEach(e => e.classList.remove('active'));
+            el.classList.add('active');
+
+            const main = document.getElementById('main');
+            main.innerHTML = '';
+            
+            const msgs = currentData[peerId];
+            main.scrollTop = 0;
+
+            msgs.forEach(msg => {
+                const div = document.createElement('div');
+                div.className = 'result';
+                
+                const date = new Date(msg.date * 1000).toLocaleString();
+                
+                div.innerHTML = '<div class="meta">MsgID: ' + msg.msg_id + 
+                              ' | From: ' + msg.from_id + 
+                              ' | ' + date + '</div>' +
+                              '<div class="text"></div>';
+                div.querySelector('.text').textContent = msg.text;
+                main.appendChild(div);
+            });
+        }
+    </script>
+</body>
+</html>
+`
+
+func main() {
+	dataPath := flag.String("path", "tdata/local_message_index", "Path to index directory")
+	port := flag.String("port", "8800", "HTTP Port")
+	flag.Parse()
+
+	indexer = NewIndexer()
+	
+	fmt.Printf("Loading index from %s...\n", *dataPath)
+	if err := indexer.LoadAll(*dataPath); err != nil {
+		fmt.Printf("Warning: %v\n", err)
+	}
+	
+	// Watch for changes (simple poll every 30s)
+	go func() {
+		for {
+			time.Sleep(30 * time.Second)
+			indexer.LoadAll(*dataPath)
+		}
+	}()
+
+	http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		t, _ := template.New("index").Parse(htmlTemplate)
+		t.Execute(w, nil)
+	})
+
+	http.HandleFunc("/api/search", func(w http.ResponseWriter, r *http.Request) {
+		query := r.URL.Query().Get("q")
+		results := indexer.Search(query)
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(results)
+	})
+
+	fmt.Printf("Server starting at http://localhost:%s\n", *port)
+	log.Fatal(http.ListenAndServe(":"+*port, nil))
+}
diff --git a/go_search_tool/parser.go b/go_search_tool/parser.go
