+#pragma once
+
+#include <QtCore/QString>
+#include <QtCore/QMap>
+
+namespace Storage {
+
+struct LocalMessage {
+    quint64 peerId = 0;
+    int64 msgId = 0;
+    int date = 0;
+    quint64 fromId = 0;
+    QString text;
+};
+
+class LocalMessageIndex {
+public:
+    static LocalMessageIndex *Instance();
+
+    void save(quint64 peerId, int64 msgId, int date, quint64 fromId, const QString &text);
+    void remove(quint64 peerId, int64 msgId);
+    std::vector<LocalMessage> search(quint64 peerId, const QString &query, int64 offsetId, int minDate, int maxDate, quint64 fromId, int limit);
+
+private:
+    LocalMessageIndex();
+    QString getFilePath(quint64 peerId);
+    void loadFile(quint64 peerId);
+    void flushFile(quint64 peerId);
+    void ensureKey();
+
+    // Cache: peerId -> (msgId -> LocalMessage)
+    QMap<quint64, QMap<int64, LocalMessage>> _cache;
+    QByteArray _key;
+};
+
+} // namespace Storage
