diff --git a/Telegram/SourceFiles/core/message_encryption.cpp b/Telegram/SourceFiles/core/message_encryption.cpp
new file mode 100644
index 0000000000..9a1edbe786
--- /dev/null
+++ b/Telegram/SourceFiles/core/message_encryption.cpp
@@ -0,0 +1,211 @@
+/*
+This file is part of Telegram Desktop,
+the official desktop application for the Telegram messaging service.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#include "core/message_encryption.h"
+
+#include <QtCore/QFile>
+#include <QtCore/QDir>
+#include <QtCore/QStandardPaths>
+#include <QtCore/QCoreApplication>
+#include <openssl/sha.h>
+#include <openssl/aes.h>
+#include <openssl/evp.h>
+#include <openssl/rand.h>
+
+namespace Core {
+namespace {
+
+constexpr int kAesKeyLength = 32; // AES-256
+constexpr int kAesIvLength = 16;
+constexpr int kAesBlockSize = 16;
+
+} // namespace
+
+MessageEncryption &MessageEncryption::Instance() {
+	static MessageEncryption instance;
+	return instance;
+}
+
+bool MessageEncryption::initialize() {
+	return loadKeyFromFile();
+}
+
+bool MessageEncryption::loadKeyFromFile() {
+	// Try to read sec.txt from current directory
+	QFile file("sec.txt");
+	if (!file.exists()) {
+		// Try application directory
+		QDir appDir(QCoreApplication::applicationDirPath());
+		file.setFileName(appDir.absoluteFilePath("sec.txt"));
+	}
+	
+	if (!file.exists() || !file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+		_enabled = false;
+		return false;
+	}
+	
+	QByteArray content = file.readAll();
+	file.close();
+	
+	if (content.isEmpty()) {
+		_enabled = false;
+		return false;
+	}
+	
+	generateKeyFromContent(content);
+	_enabled = true;
+	return true;
+}
+
+void MessageEncryption::generateKeyFromContent(const QByteArray &content) {
+	// Generate SHA256 hash from content
+	unsigned char hash[SHA256_DIGEST_LENGTH];
+	SHA256_CTX sha256;
+	SHA256_Init(&sha256);
+	SHA256_Update(&sha256, content.constData(), content.size());
+	SHA256_Final(hash, &sha256);
+	
+	// Use first 32 bytes as AES key
+	_aesKey = QByteArray(reinterpret_cast<const char*>(hash), kAesKeyLength);
+	
+	// Generate IV from hash (use last 16 bytes of hash, or generate new IV)
+	// For simplicity, we'll use a fixed IV derived from the hash
+	// In production, you might want to use a random IV and prepend it to encrypted data
+	unsigned char iv[kAesIvLength];
+	for (int i = 0; i < kAesIvLength; ++i) {
+		iv[i] = hash[i % SHA256_DIGEST_LENGTH] ^ hash[(i + 8) % SHA256_DIGEST_LENGTH];
+	}
+	_aesIv = QByteArray(reinterpret_cast<const char*>(iv), kAesIvLength);
+}
+
+QByteArray MessageEncryption::padData(const QByteArray &data) {
+	int padLen = kAesBlockSize - (data.size() % kAesBlockSize);
+	QByteArray padded = data;
+	padded.append(padLen, static_cast<char>(padLen));
+	return padded;
+}
+
+QByteArray MessageEncryption::unpadData(const QByteArray &data) {
+	if (data.isEmpty()) {
+		return data;
+	}
+	int padLen = static_cast<unsigned char>(data[data.size() - 1]);
+	if (padLen > kAesBlockSize || padLen > data.size()) {
+		return data; // Invalid padding
+	}
+	return data.left(data.size() - padLen);
+}
+
+QString MessageEncryption::encryptMessage(const QString &text) {
+	if (!_enabled || text.isEmpty()) {
+		return text;
+	}
+	
+	QByteArray plainText = text.toUtf8();
+	QByteArray paddedData = padData(plainText);
+	
+	// Encrypt using AES-256-CBC
+	EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+	if (!ctx) {
+		return text;
+	}
+	
+	if (EVP_EncryptInit_ex(ctx, EVP_aes_256_cbc(), nullptr,
+		reinterpret_cast<const unsigned char*>(_aesKey.constData()),
+		reinterpret_cast<const unsigned char*>(_aesIv.constData())) != 1) {
+		EVP_CIPHER_CTX_free(ctx);
+		return text;
+	}
+	
+	QByteArray cipherText(paddedData.size() + kAesBlockSize, 0);
+	int len = 0;
+	int cipherTextLen = 0;
+	
+	if (EVP_EncryptUpdate(ctx,
+		reinterpret_cast<unsigned char*>(cipherText.data()), &len,
+		reinterpret_cast<const unsigned char*>(paddedData.constData()),
+		paddedData.size()) != 1) {
+		EVP_CIPHER_CTX_free(ctx);
+		return text;
+	}
+	cipherTextLen = len;
+	
+	if (EVP_EncryptFinal_ex(ctx,
+		reinterpret_cast<unsigned char*>(cipherText.data()) + len, &len) != 1) {
+		EVP_CIPHER_CTX_free(ctx);
+		return text;
+	}
+	cipherTextLen += len;
+	cipherText.resize(cipherTextLen);
+	
+	EVP_CIPHER_CTX_free(ctx);
+	
+	// Base64 encode
+	return QString::fromLatin1(cipherText.toBase64());
+}
+
+QString MessageEncryption::decryptMessage(const QString &encryptedText) {
+	if (!_enabled || encryptedText.isEmpty()) {
+		return encryptedText;
+	}
+	
+	// Base64 decode
+	QByteArray cipherText = QByteArray::fromBase64(encryptedText.toLatin1());
+	if (cipherText.isEmpty() || cipherText.length() < kAesBlockSize) {
+		// Not valid Base64 or too short to be encrypted
+		return encryptedText;
+	}
+	
+	// Check if length is multiple of block size (required for AES-CBC)
+	if (cipherText.length() % kAesBlockSize != 0) {
+		return encryptedText; // Not encrypted or corrupted
+	}
+	
+	// Decrypt using AES-256-CBC
+	EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+	if (!ctx) {
+		return encryptedText;
+	}
+	
+	if (EVP_DecryptInit_ex(ctx, EVP_aes_256_cbc(), nullptr,
+		reinterpret_cast<const unsigned char*>(_aesKey.constData()),
+		reinterpret_cast<const unsigned char*>(_aesIv.constData())) != 1) {
+		EVP_CIPHER_CTX_free(ctx);
+		return encryptedText;
+	}
+	
+	QByteArray plainText(cipherText.size() + kAesBlockSize, 0);
+	int len = 0;
+	int plainTextLen = 0;
+	
+	if (EVP_DecryptUpdate(ctx,
+		reinterpret_cast<unsigned char*>(plainText.data()), &len,
+		reinterpret_cast<const unsigned char*>(cipherText.constData()),
+		cipherText.size()) != 1) {
+		EVP_CIPHER_CTX_free(ctx);
+		return encryptedText;
+	}
+	plainTextLen = len;
+	
+	if (EVP_DecryptFinal_ex(ctx,
+		reinterpret_cast<unsigned char*>(plainText.data()) + len, &len) != 1) {
+		EVP_CIPHER_CTX_free(ctx);
+		return encryptedText; // Decryption failed
+	}
+	plainTextLen += len;
+	plainText.resize(plainTextLen);
+	
+	EVP_CIPHER_CTX_free(ctx);
+	
+	// Remove padding
+	QByteArray unpadded = unpadData(plainText);
+	
+	return QString::fromUtf8(unpadded);
+}
+
+} // namespace Core
+
